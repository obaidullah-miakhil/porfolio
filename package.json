{
  "name": "obaidullah-miakhil-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/sync-locale-routes.mjs",
    "build": "NODE_ENV=production next build && node scripts/check-no-gradients.mjs",
    "start": "next start -p 3000 -H 0.0.0.0",
    "clean": "rm -rf .next dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check:gradients": "node scripts/check-no-gradients.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "tsx --test src/lib/profile.test.ts",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "analyze": "NODE_ENV=production ANALYZE=true next build"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^0.546.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0",
    "three": "^0.186.1",
    "vazirmatn": "^33.0.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "playwright": "^1.50.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  }
}
