# Canonical site URL (required for metadataBase, canonicals, sitemap, OG URLs and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://obaidullah.online

# Optional: GitHub Personal Access Token (read-only, public repos) to avoid build-time API rate limits
GITHUB_TOKEN=

# Optional: Google Search Console HTML meta tag verification token
NEXT_PUBLIC_GSC_VERIFICATION=
